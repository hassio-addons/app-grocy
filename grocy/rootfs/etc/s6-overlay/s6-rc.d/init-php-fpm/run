#!/command/with-contenv bashio
# shellcheck shell=bash
# ==============================================================================
# Home Assistant Community Add-on: Grocy
# Configures PHP-FPM for use with Grocy
# ==============================================================================

# PHP does not read the TZ environment variable, so pass on the timezone
# provided by the Supervisor. Grocy relies on it, e.g., for the iCal export.
echo "date.timezone = ${TZ:-UTC}" > /etc/php85/conf.d/98-timezone.ini

# Generate Ingress configuration
bashio::var.json \
    name "ingress" \
    port "^9002" \
    base "$(bashio::app.ingress_entry)" \
    | tempio \
        -template /etc/php85/templates/php-fpm.gtpl \
        -out /etc/php85/php-fpm.d/ingress.conf

# Generate direct access configuration, if enabled.
if bashio::var.has_value "$(bashio::app.port 80)"; then
    bashio::var.json \
        name "www" \
        port "^9001" \
        | tempio \
            -template /etc/php85/templates/php-fpm.gtpl \
            -out /etc/php85/php-fpm.d/www.conf
fi
